<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      net10.0-windows + WinForms purely for System.Windows.Forms.TextRenderer. MSI paints Text
      controls with GDI DrawText, and TextRenderer is the only managed wrapper over the same API —
      GDI+ (Graphics.MeasureString) measures differently and would not predict what the installer
      actually clips. This product is Windows-only, so the narrower TFM costs nothing.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The installer source is the subject under test, copied next to the test assembly so the tests
    read a deterministic path instead of walking up from the output directory.
  -->
  <ItemGroup>
    <Content Include="..\..\packaging\Obsync.wxs" Link="Obsync.wxs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
