<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Obsync.Engine\Obsync.Engine.csproj" />
    <ProjectReference Include="..\..\src\Obsync.Shared\Obsync.Shared.csproj" />
  </ItemGroup>

  <!--
    The GitHub service source is the subject of RetryHelperInvariantTests: the rule that only
    idempotent calls may be retried cannot be expressed in the type system, and a comment asserting
    it protects nothing. Copied next to the test assembly so the test reads a deterministic path.
  -->
  <ItemGroup>
    <Content Include="..\..\src\Obsync.GitHub\GitHubService.cs" Link="GitHubService.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
