<?xml version="1.0" encoding="utf-8"?>
<!--
  Obsync MSI installer (per-machine, x64, self-contained — no .NET runtime or git prerequisite).

  Installs the desktop app, the CLI (obsync.exe, added to PATH), a bundled MinGit under tools\git\
  (harvested from the staging folder), and the background Windows service ("Obsync"). The service is
  registered delayed auto-start and started at the end of the install, so schedules keep firing
  across reboots without anyone opening services.msc; its logon account is set from the
  SERVICE_ACCOUNT / SERVICE_PASSWORD properties. Because Obsync stores secrets in the per-user
  Windows Credential Manager and data under %LOCALAPPDATA%, the service must run under the SAME
  account that runs the desktop app — pass that account for scheduled runs to work (under the
  LocalSystem default the service runs but idles against an empty data root, and the app's
  scheduler-health banner tells the user exactly that):

    msiexec /i Obsync-0.1.0-win-x64.msi SERVICE_ACCOUNT="DOMAIN\user" SERVICE_PASSWORD="secret" /qn

  For a group Managed Service Account pass SERVICE_ACCOUNT="DOMAIN\name$" and no SERVICE_PASSWORD:
  MSI does not distinguish an empty string from null (empty Formatted values are null), so the
  ServiceInstall hands CreateService a NULL password, which is what gMSA logons require.

  UI: the stock WixUI_InstallDir dialog set is copied below (the documented WiX customization path —
  the set cannot be extended in place) with these changes: a Service Account dialog between the
  install-directory and ready pages, an optional "Launch Obsync" checkbox on the finish page,
  ARPNOMODIFY left unset so Repair stays available from Add/Remove Programs, Segoe UI text styles
  instead of Tahoma, and reworded stock-page copy via packaging\Obsync.wxl (loc-string overrides;
  purely presentational).

  Built by packaging/build-installer.ps1, which supplies the Version/PublishDir/PackagingDir/RepoRoot
  preprocessor variables and stages MinGit into PublishDir\tools\git.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Obsync"
           Manufacturer="Obsync"
           Version="$(Version)"
           UpgradeCode="7B2E9E9C-3C1E-4C7A-9E2B-0A1F6D5C4B30"
           Scope="perMachine"
           Compressed="yes">

    <!-- Schedule left at WiX's default (afterInstallValidate): verified in the built MSI as
         RemoveExistingProducts at 1401, so the old product is fully uninstalled (StopServices 1900,
         DeleteServices 2000) before InstallInitialize (1500) and the "Obsync" service is created
         fresh at InstallServices (5800). Two costs, both accepted:
           * The delete/create window spans the whole file copy of the new build, so anything
             holding an SCM handle to "Obsync" (services.msc left open) keeps the delete pending and
             CreateService fails with ERROR_SERVICE_MARKED_FOR_DELETE (1072). That fails the upgrade
             LOUDLY and rolls back — close services.msc and rerun.
           * If the nested uninstall fails after its DeleteServices, its rollback recreates the
             service without a password (the SCM never hands one back). That is the same state a
             normal upgrade already lands in and that the product already handles, and no
             rescheduling can fix it — no MSI rollback can restore an LSA secret.
         Schedule="afterInstallExecute" (RemoveExistingProducts at 6501) was considered and
         rejected. It would reconfigure the service instead of recreating it, but it runs the OLD
         product's uninstall — including its DeleteServices — AFTER the new service is installed and
         started, leaving correctness to component reference counting. INSTALL.md allows upgrading
         into a DIFFERENT folder, where the old client points at the old path: the old install tree
         and its PATH entry are orphaned with nothing tracking them, and any gap in service
         refcounting silently deletes the service Obsync exists to run. A loud, retryable 1072 beats
         a silently missing service. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Obsync is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Product icon and Add/Remove Programs metadata. The icon Id must end in ".exe" because the
         advertised Start Menu shortcut's key file is an exe (ICE50). -->
    <Icon Id="ObsyncApp.exe" SourceFile="$(RepoRoot)\src\Obsync.App\Assets\Obsync.ico" />
    <Property Id="ARPPRODUCTICON" Value="ObsyncApp.exe" />
    <Property Id="ARPHELPLINK" Value="https://github.com/obsync-io/obsync" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/obsync-io/obsync" />

    <!-- Windows Service logon account. Defaults to LocalSystem (functional host, but it cannot reach
         the interactive user's Credential Manager / data root, so scheduled runs need a real account
         here; Secure so it can be set during a silent, elevated install). The last configured account
         is remembered so a MAJOR UPGRADE does not silently reset a working service back to
         LocalSystem — Windows cannot remember the password, so an interactive upgrade prefills the
         account and asks for the password again, and a silent upgrade of a password-logon service
         must re-pass SERVICE_PASSWORD (gMSA/virtual/LocalSystem accounts need none). -->
    <!-- The silent-install counterpart of the interactive blank-password guard below.

         That guard is a dialog Publish, so it exists only in the UI sequence: `msiexec /qn
         SERVICE_ACCOUNT="DOMAIN\user"` with no SERVICE_PASSWORD sailed straight past it and
         installed a service that can never log on, while reporting success. Silent installs are how
         this product reaches fleets, so the failure arrived at scale with nothing to read.

         Gated on UILevel so it only fires where the Service Account dialog cannot run. The boundary
         is 5, not 4: INSTALLUILEVEL_REDUCED (4, `msiexec /qr`) is "authored UI with the WIZARD
         DIALOGS SUPPRESSED", so /qr never shows the dialog and needs the guard exactly as much as
         /qn does. Exempting 4 let /qr install a service that could never log on — the precise
         failure this condition exists to prevent.

         The leading `Installed` term is load-bearing, and its absence made this guard far more
         destructive than the bug it fixed. Two facts combine:

           * LaunchConditions runs at sequence 100, but AppSearch is at 50 and SetSERVICE_ACCOUNT at
             52 (verified in the built MSI, not assumed — WiX does not use the SDK's suggested
             AppSearch-after-LaunchConditions ordering). So by the time this is evaluated,
             SERVICE_ACCOUNT has ALREADY been filled in from the RegistrySearch chain below. The
             condition cannot distinguish an account the operator passed from one the installer just
             read out of the SCM, so `NOT SERVICE_ACCOUNT` does not mean "none was supplied".
           * LaunchConditions and AppSearch both carry an EMPTY sequence condition, so they run on
             every transaction — uninstall and repair included, where DeleteServices has not run yet
             and the search still finds the live account.

         Together those made `msiexec /x ... /qn`, `msiexec /fa ... /qn`, and MSI self-repair (which
         the advertised Start Menu shortcut triggers at UILevel 3) all fail 1603 on any install using
         a password account — a product that cannot be uninstalled unattended breaks SCCM
         supersedence and Intune retirement, and no password is even needed to uninstall.

         `Installed` is true for maintenance and uninstall of THIS product and false for a first
         install and for a major upgrade (the upgrade runs under a new ProductCode). That is exactly
         the line we want, because it tracks whether the service is RE-CREATED:
           * repair/maintenance reconfigures the existing service, and ChangeServiceConfig with a
             null password leaves the stored password alone, so no password is needed;
           * a major upgrade deletes and re-creates it (RemoveExistingProducts at 1401), so the
             password genuinely cannot be recovered and must be re-supplied.
         The upgrade case therefore still blocks, deliberately: refusing loudly beats installing a
         service that cannot log on. INSTALL.md documents it as a hard requirement of unattended
         upgrades.

         Same allow-list of passwordless principals as the dialog: a gMSA ends in "$", and the
         NT AUTHORITY / NT SERVICE built-ins take a null password by design. -->
    <Launch Condition="Installed OR UILevel &gt;= 5 OR NOT SERVICE_ACCOUNT OR SERVICE_PASSWORD OR (SERVICE_ACCOUNT &gt;&gt; &quot;$&quot;) OR (SERVICE_ACCOUNT ~= &quot;LocalSystem&quot;) OR (SERVICE_ACCOUNT ~= &quot;LocalService&quot;) OR (SERVICE_ACCOUNT ~= &quot;NetworkService&quot;) OR (SERVICE_ACCOUNT ~&lt;&lt; &quot;NT AUTHORITY\&quot;) OR (SERVICE_ACCOUNT ~&lt;&lt; &quot;NT SERVICE\&quot;)"
            Message="The Obsync service is set to log on as [SERVICE_ACCOUNT], but SERVICE_PASSWORD was not supplied. Windows cannot hand an existing service's password back to an installer, and an upgrade re-creates the service — so it would be installed unable to log on (error 1069). Re-run with SERVICE_PASSWORD=&quot;...&quot; for that account, or with SERVICE_ACCOUNT=&quot;LocalSystem&quot; to install without scheduled runs and set the account afterwards." />

    <Property Id="SERVICE_ACCOUNT" Secure="yes" />
    <Property Id="SERVICE_PASSWORD" Secure="yes" Hidden="yes" />

    <!-- The remembered account is searched into its OWN property, never straight into
         SERVICE_ACCOUNT. AppSearch overwrites a property that is already set, and it runs at
         sequence 50 of BOTH sequences — so searching into SERVICE_ACCOUNT discarded every explicit
         answer: a command-line SERVICE_ACCOUNT on a silent upgrade (applying the newly supplied
         password to the OLD account), and even the dialog's own answer, because the UI sequence's
         value was clobbered when AppSearch re-ran in the execute sequence. The Property-table
         default survives a failed search, which is what makes LocalSystem the first-install value. -->
    <Property Id="SERVICE_ACCOUNT_REMEMBERED" Value="LocalSystem">
      <RegistrySearch Id="RememberedServiceAccount" Root="HKLM" Key="SOFTWARE\Obsync" Name="ServiceAccount" Type="raw" />
    </Property>

    <!-- What the service is configured with RIGHT NOW, from the SCM's own registry. Preferred over
         our remembered copy because it also reflects an out-of-band change (`sc.exe config`, or the
         services.msc Log On tab — both of which INSTALL.md tells users to use), so a repair or an
         upgrade can no longer silently revert one. -->
    <Property Id="SERVICE_ACCOUNT_INSTALLED">
      <RegistrySearch Id="InstalledServiceAccount" Root="HKLM"
                      Key="SYSTEM\CurrentControlSet\Services\Obsync" Name="ObjectName" Type="raw" />
    </Property>
    <SetProperty Id="SERVICE_ACCOUNT_REMEMBERED" Value="[SERVICE_ACCOUNT_INSTALLED]" After="AppSearch"
                 Condition="SERVICE_ACCOUNT_INSTALLED" />

    <!-- The remembered account is only a DEFAULT: an explicit answer always wins. -->
    <SetProperty Id="SERVICE_ACCOUNT" Value="[SERVICE_ACCOUNT_REMEMBERED]" After="SetSERVICE_ACCOUNT_REMEMBERED"
                 Condition="NOT SERVICE_ACCOUNT" />

    <!-- Interactive-only staging for the Service Account dialog. The dialog copies its answers into
         SERVICE_ACCOUNT / SERVICE_PASSWORD on Next, so silent installs are untouched. A remembered
         custom account preselects "This account" with the name prefilled. -->
    <Property Id="SERVICE_ACCOUNT_MODE" Value="system" />
    <Property Id="SERVICE_ACCOUNT_PWD" Hidden="yes" />
    <SetProperty Id="SERVICE_ACCOUNT_MODE" Value="custom" After="SetSERVICE_ACCOUNT"
                 Condition="SERVICE_ACCOUNT AND SERVICE_ACCOUNT &lt;&gt; &quot;LocalSystem&quot;" />
    <SetProperty Id="SERVICE_ACCOUNT_NAME" Value="[SERVICE_ACCOUNT]" After="SetSERVICE_ACCOUNT_MODE"
                 Condition="SERVICE_ACCOUNT AND SERVICE_ACCOUNT &lt;&gt; &quot;LocalSystem&quot;" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Obsync" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="Obsync" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="AppHost" />
      <ComponentRef Id="ServiceHost" />
      <ComponentRef Id="ServiceLogonRight" />
      <ComponentRef Id="PathEntry" />
    </Feature>

    <UIRef Id="ObsyncUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(PackagingDir)\License.rtf" />

    <!-- Branded dialog bitmaps (generated by packaging\assets\generate-bitmaps.py). These bind
         variables feed the WixUI_Bmp_Dialog / WixUI_Bmp_Banner Binary rows that every dialog in the
         set references — including ObsyncServiceAccountDlg, whose banner control uses the stock
         !(loc.InstallDirDlgBannerBitmap) string — so all pages pick them up. -->
    <WixVariable Id="WixUIDialogBmp" Value="$(PackagingDir)\assets\dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(PackagingDir)\assets\banner.bmp" />

    <!-- Optional "Launch Obsync" checkbox on the finish page (WixShellExec runs impersonated, so the
         app starts as the installing user, not elevated). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Obsync" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#ObsyncAppExe]" />
    <CustomAction Id="LaunchObsyncApp"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixShellExec"
                  Execute="immediate"
                  Return="check"
                  Impersonate="yes" />
  </Package>

  <Fragment>
    <!-- Harvest the entire self-contained publish folder (including tools\git\, the bundled MinGit)
         EXCEPT the two exes that need stable File Ids: the service exe carries the ServiceInstall and
         the app exe is the WixShellExec launch target. -->
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)\**">
        <Exclude Files="$(PublishDir)\Obsync.App.exe" />
        <Exclude Files="$(PublishDir)\Obsync.Service.exe" />
      </Files>
    </ComponentGroup>

    <!-- The desktop app host, referenced by the finish-page launch action. The Start Menu shortcut
         is advertised and lives on this file: the ICE38/43/57-clean shape for a per-machine MSI
         (a separate registry-keypath component would need per-user HKCU data). -->
    <Component Id="AppHost" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="ObsyncAppExe" Source="$(PublishDir)\Obsync.App.exe" KeyPath="yes">
        <Shortcut Id="ObsyncStartMenu"
                  Directory="ProgramMenuFolder"
                  Name="Obsync"
                  Description="Script and sync SQL Server objects to GitHub"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ObsyncApp.exe"
                  Advertise="yes" />
      </File>
    </Component>

    <!-- The Windows service host. Registered as "Obsync" (matches AddWindowsService and the app's
         scheduler-health check). Delayed auto-start so schedules survive reboots with no manual
         step; started at install end (Wait="no" — a start failure, e.g. an account missing the
         "Log on as a service" right, must not roll back the install; the app's health banner
         reports a stopped service with the fix). Stop/remove keep their own element so they still
         Wait="yes" — files can't be replaced or removed under a running service.
         Recovery: restart 60s after each of the first three failures, counter resets daily. The
         "Obsync" Application-log event source backs the service's Warning+ EventLog sink and is
         registered here so the service never needs the (admin-only) right to create it. -->
    <Component Id="ServiceHost" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="ObsyncServiceExe" Source="$(PublishDir)\Obsync.Service.exe" KeyPath="yes" />
      <ServiceInstall Id="ObsyncServiceInstall"
                      Name="Obsync"
                      DisplayName="Obsync Sync Service"
                      Description="Runs Obsync scheduled sync jobs in the background."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="[SERVICE_ACCOUNT]"
                      Password="[SERVICE_PASSWORD]">
        <!-- Delayed auto-start (the MSI 5.0 ServiceConfig table; WiX has no attribute for it on
             ServiceInstall itself). -->
        <ServiceConfig DelayedAutoStart="yes" OnInstall="yes" OnReinstall="yes" />
      </ServiceInstall>
      <ServiceControl Id="ObsyncServiceControl" Name="Obsync" Stop="both" Remove="uninstall" Wait="yes" />
      <ServiceControl Id="ObsyncServiceStart" Name="Obsync" Start="install" Wait="no" />
      <util:ServiceConfig ServiceName="Obsync"
                          FirstFailureActionType="restart"
                          SecondFailureActionType="restart"
                          ThirdFailureActionType="restart"
                          RestartServiceDelayInSeconds="60"
                          ResetPeriodInDays="1" />
      <util:EventSource Log="Application"
                        Name="Obsync"
                        EventMessageFile="[WindowsFolder]Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />

      <!-- Remember the logon account (never the password) so upgrades default to it instead of
           silently resetting a working service to LocalSystem. -->
      <RegistryValue Root="HKLM" Key="SOFTWARE\Obsync" Name="ServiceAccount" Value="[SERVICE_ACCOUNT]" Type="string" />
    </Component>

    <!-- Grant "Log on as a service" (SeServiceLogonRight) to the chosen account.

         INSTALL.md claimed this already happened "by the installer's service assignment". It did
         not: MSI's CreateService does not grant the right, and nothing else here did either. The
         installer is the last elevated moment where it can happen without a second admin step, and
         it passed — so a domain account chosen in the wizard produced a service that installed
         cleanly and then failed to start with Error 1069 (logon failure), which reads as a wrong
         password and is not one.

         CreateUser="no" is essential: the account already exists (domain, gMSA, or built-in) and
         this must only ADD the right, never create or modify the principal. UpdateIfExists makes it
         idempotent across repair and upgrade. RemoveOnUninstall is deliberately left off: revoking
         a right the site may have granted for its own reasons is not the uninstaller's business.

         Conditioned, because the right is meaningless for the built-in service principals —
         LocalSystem, LocalService and NetworkService hold it implicitly — and naming one here would
         send the custom action looking up a principal that grants nothing. A gMSA (DOMAIN
ame$) is
         NOT excluded: it is an ordinary account for this purpose and does need the right.

         LIMIT, and a real one: where SeServiceLogonRight is defined by Group Policy, this local
         grant is overwritten at the next policy refresh, and a "Deny log on as a service" entry
         beats it outright. No installer can fix that; SchedulerHealthService names the case so the
         user is not left re-entering a password that was never the problem. -->
    <Component Id="ServiceLogonRight" Directory="INSTALLFOLDER" Bitness="always64"
               Condition="SERVICE_ACCOUNT AND NOT (SERVICE_ACCOUNT ~= &quot;LocalSystem&quot;) AND NOT (SERVICE_ACCOUNT ~= &quot;LocalService&quot;) AND NOT (SERVICE_ACCOUNT ~= &quot;NetworkService&quot;) AND NOT (SERVICE_ACCOUNT ~&lt;&lt; &quot;NT AUTHORITY\&quot;) AND NOT (SERVICE_ACCOUNT ~&lt;&lt; &quot;NT SERVICE\&quot;)">
      <RegistryValue Root="HKLM" Key="SOFTWARE\Obsync" Name="ServiceLogonRightGranted" Type="integer" Value="1" KeyPath="yes" />
      <util:User Id="ObsyncServiceLogonRight"
                 Name="[SERVICE_ACCOUNT]"
                 CreateUser="no"
                 UpdateIfExists="yes"
                 FailIfExists="no"
                 LogonAsService="yes" />
    </Component>

    <!-- Add the install directory to the machine PATH so `obsync` (the CLI) is callable anywhere. -->
    <Component Id="PathEntry" Directory="INSTALLFOLDER" Bitness="always64">
      <Environment Id="ObsyncPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\Obsync" Name="pathAdded" Type="integer" Value="1" KeyPath="yes" />
    </Component>
  </Fragment>

  <!--
    The WixUI_InstallDir dialog set from WiX 5.0.2, copied verbatim (x64 only) and customized — the
    stock set publishes cannot be overridden in place and it force-sets ARPNOMODIFY. Changes from
    stock are marked with "Obsync:" comments. Flow (first install):

      Welcome → License (accept required) → Install Dir → Service Account → Verify Ready → Progress
      → Finish (optional Launch Obsync)

    Maintenance (Repair/Remove) and patch flows are stock and skip the Service Account dialog.
  -->
  <Fragment>
    <UI Id="ObsyncUI_InstallDir">
      <!-- Obsync: Segoe UI instead of the stock Tahoma — matches the app and every modern Windows
           wizard. Control rectangles are fixed installer units, so sizes stay conservative (9 pt
           body ≈ the Windows message font) to keep the stock layouts truncation-free. -->
      <!-- Obsync: colours from the app's own Colors.xaml, so the wizard and the application it
           installs share one palette rather than only a logo.

           Before this there was not a single colour anywhere in the installer: every string was
           system-default black on system-default grey, and the ONLY brand presence in the whole
           wizard was two BMP files. Colour is also the one styling lever MSI actually gives you —
           there is no colour column in the Dialog or Control tables, so TextStyle is where the
           entire palette has to live. Note it applies to Text controls only; buttons, checkboxes
           and edits keep their system colours, which is correct (they should look like Windows).

           Titles take AccentHover rather than AccentColor: #1B17FF is tuned to be an accent on a
           surface, and at 9pt bold it reads as too loud for a heading. Body takes TextPrimary
           instead of pure black for the same reason the app does — #000000 is heavier than any
           ink the app uses. Nothing is drawn over the dark panel (page text starts at 135 units,
           the panel ends at ~128), so these are all on white. -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Segoe UI" Size="9" Red="17" Green="24" Blue="39" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Segoe UI" Size="12" Red="17" Green="24" Blue="39" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Segoe UI" Size="9" Bold="yes" Red="21" Green="18" Blue="214" />

      <!-- Secondary text, matching the app's Caption style (TextMuted). Used for the explanatory
           notes on the Service Account page so they rank below the controls they describe — and,
           at 8pt, one line is 13 units rather than 15, which is what lets two paragraphs fit
           between the password field and BottomLine at all. -->
      <TextStyle Id="WixUI_Font_Note" FaceName="Segoe UI" Size="8" Red="107" Green="114" Blue="128" />

      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />

      <!-- Obsync: launch the app when the finish-page checkbox is ticked (before EndDialog at 999). -->
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchObsyncApp" Order="998" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <!-- Obsync: continue to the Service Account dialog instead of straight to Verify Ready. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="ObsyncServiceAccountDlg" Order="4" Condition="WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <!-- Obsync: the Service Account dialog sits between Install Dir and Verify Ready. Next copies
           the staged answers into the real SERVICE_ACCOUNT / SERVICE_PASSWORD properties; "{}"
           clears a property, and a cleared SERVICE_PASSWORD reaches CreateService as NULL (gMSA). -->
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Property="SERVICE_ACCOUNT" Value="[SERVICE_ACCOUNT_NAME]" Order="1" Condition="SERVICE_ACCOUNT_MODE = &quot;custom&quot; AND SERVICE_ACCOUNT_NAME" />
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Property="SERVICE_PASSWORD" Value="[SERVICE_ACCOUNT_PWD]" Order="2" Condition="SERVICE_ACCOUNT_MODE = &quot;custom&quot; AND SERVICE_ACCOUNT_PWD" />
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Property="SERVICE_PASSWORD" Value="{}" Order="3" Condition="SERVICE_ACCOUNT_MODE = &quot;custom&quot; AND NOT SERVICE_ACCOUNT_PWD" />
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Property="SERVICE_ACCOUNT" Value="LocalSystem" Order="4" Condition="SERVICE_ACCOUNT_MODE = &quot;system&quot;" />
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Property="SERVICE_PASSWORD" Value="{}" Order="5" Condition="SERVICE_ACCOUNT_MODE = &quot;system&quot;" />
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Event="SpawnDialog" Value="ObsyncAccountRequiredDlg" Order="6" Condition="SERVICE_ACCOUNT_MODE = &quot;custom&quot; AND NOT SERVICE_ACCOUNT_NAME" />
      <!-- Obsync: a blank password is a legitimate answer only for accounts Windows logs on without
           one — a gMSA (trailing "$"), a virtual account (NT SERVICE\...), or a built-in service
           account (NT AUTHORITY\...). For anything else it reaches CreateService as a NULL password
           and the service installs but cannot log on (error 1069), which a click-through UPGRADE
           reproduces every time: the account is prefilled from the registry and the password box
           never is. MSI's ends-with/starts-with operators do the test ("~" = case-insensitive);
           the literals are quoted so the comparison stays a string one. -->
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Event="SpawnDialog" Value="ObsyncPasswordRequiredDlg" Order="7" Condition="SERVICE_ACCOUNT_MODE = &quot;custom&quot; AND SERVICE_ACCOUNT_NAME AND NOT SERVICE_ACCOUNT_PWD AND NOT (SERVICE_ACCOUNT_NAME &gt;&gt; &quot;$&quot;) AND NOT (SERVICE_ACCOUNT_NAME ~&lt;&lt; &quot;NT AUTHORITY\&quot;) AND NOT (SERVICE_ACCOUNT_NAME ~&lt;&lt; &quot;NT SERVICE\&quot;)" />
      <Publish Dialog="ObsyncServiceAccountDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="8" Condition="SERVICE_ACCOUNT_MODE = &quot;system&quot; OR (SERVICE_ACCOUNT_NAME AND (SERVICE_ACCOUNT_PWD OR (SERVICE_ACCOUNT_NAME &gt;&gt; &quot;$&quot;) OR (SERVICE_ACCOUNT_NAME ~&lt;&lt; &quot;NT AUTHORITY\&quot;) OR (SERVICE_ACCOUNT_NAME ~&lt;&lt; &quot;NT SERVICE\&quot;)))" />

      <!-- Obsync: Back from Verify Ready returns to the Service Account dialog on first install. -->
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="ObsyncServiceAccountDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />

      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- Obsync: ARPNOMODIFY deliberately NOT set (stock set forces it to 1) so "Modify" → Repair
           stays available in Add/Remove Programs. -->

      <!-- Obsync: chooses the account the "Obsync" Windows service logs on with. -->
      <Dialog Id="ObsyncServiceAccountDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose the account that runs scheduled sync jobs." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Service account" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="AccountMode" Type="RadioButtonGroup" Property="SERVICE_ACCOUNT_MODE" X="20" Y="55" Width="330" Height="40">
          <RadioButtonGroup Property="SERVICE_ACCOUNT_MODE">
            <RadioButton Value="system" X="0" Y="0" Width="320" Height="16" Text="Local S&amp;ystem — configure later" />
            <RadioButton Value="custom" X="0" Y="20" Width="320" Height="16" Text="T&amp;his account:" />
          </RadioButtonGroup>
        </Control>

        <!-- Obsync: one Segoe UI 9 line is 15 units — measured, and pinned by DialogTextFitTests.
             These labels were 12, so each was cut through its descenders AND its true extent ran
             into the edit box two units below it. Both are 15 now and sit 16 above their edit.
             (An overflowing MSI Text control also path-ellipsizes text containing backslashes —
             "Account ...\user):" — rather than wrapping, which is how this hid for so long.) -->
        <Control Id="AccountLabel" Type="Text" TabSkip="no" X="36" Y="96" Width="304" Height="15" NoPrefix="no" Text="&amp;Account (DOMAIN\user or .\user):"
                 EnableCondition="SERVICE_ACCOUNT_MODE = &quot;custom&quot;" DisableCondition="SERVICE_ACCOUNT_MODE &lt;&gt; &quot;custom&quot;" />
        <Control Id="AccountEdit" Type="Edit" X="36" Y="112" Width="304" Height="16" Property="SERVICE_ACCOUNT_NAME"
                 EnableCondition="SERVICE_ACCOUNT_MODE = &quot;custom&quot;" DisableCondition="SERVICE_ACCOUNT_MODE &lt;&gt; &quot;custom&quot;" />
        <Control Id="PasswordLabel" Type="Text" TabSkip="no" X="36" Y="128" Width="304" Height="15" NoPrefix="no" Text="&amp;Password:"
                 EnableCondition="SERVICE_ACCOUNT_MODE = &quot;custom&quot;" DisableCondition="SERVICE_ACCOUNT_MODE &lt;&gt; &quot;custom&quot;" />
        <Control Id="PasswordEdit" Type="Edit" Password="yes" X="36" Y="146" Width="304" Height="16" Property="SERVICE_ACCOUNT_PWD"
                 EnableCondition="SERVICE_ACCOUNT_MODE = &quot;custom&quot;" DisableCondition="SERVICE_ACCOUNT_MODE &lt;&gt; &quot;custom&quot;" />

        <!-- Obsync: two short paragraphs read better than one dense block — the first states the
             per-account vault constraint, the second covers gMSA.
             Both boxes are 30 units, exactly two Segoe UI 9 lines, and both strings are written to
             fit two lines at width 330 (61 characters per line, measured). They were 24 units
             against strings that wrapped to three, so a third of each paragraph was invisible.
             Both use WixUI_Font_Note (8pt, TextMuted), which ranks them below the controls they
             describe and — because an 8pt line is 13 units rather than 15 — is what lets two
             paragraphs fit here at all. The budget is hard: only 66 units separate the password
             field from BottomLine at 234, so each note gets exactly two lines and the copy has to
             fit them. DialogTextFitTests measures it in the note font rather than trusting anyone's
             character count, which is the mistake that produced the previous sizes. -->
        <Control Id="VaultNote" Type="Text" X="20" Y="170" Width="330" Height="26" NoPrefix="yes"
                 Text="{\WixUI_Font_Note}Credentials are stored per Windows account — scheduled jobs read this account's vault." />
        <Control Id="GmsaNote" Type="Text" X="20" Y="202" Width="330" Height="26" NoPrefix="yes"
                 Text="{\WixUI_Font_Note}For a group Managed Service Account: DOMAIN\name$, no password. Store its secrets with obsync credential set." />
      </Dialog>

      <!-- Obsync: shown when "This account" is selected but no account was entered. The Text control
           gets three Segoe UI lines of headroom — an overflowing MSI Text control path-ellipsizes
           text that contains backslashes rather than wrapping further. -->
      <Dialog Id="ObsyncAccountRequiredDlg" Width="260" Height="105" Title="[ProductName] Setup">
        <Control Id="OK" Type="PushButton" X="100" Y="78" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="!(loc.InvalidDirDlgIconTooltip)" FixedSize="yes" IconSize="32" Text="!(loc.InvalidDirDlgIcon)" />
        <!-- 45 units = the three Segoe UI 9 lines this wraps to at width 194 (26 characters a line,
             measured). It was 40, so the third line was cut; the dialog grew by 10 to keep the
             button clear of it. -->
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="45" NoPrefix="yes"
                 Text="Enter an account (DOMAIN\user, or .\user for a local account), or choose Local System." />
      </Dialog>

      <!-- Obsync: shown when "This account" is selected with a blank password for an account that
           is not one of the passwordless kinds. Same shape as ObsyncAccountRequiredDlg, one line
           taller because the text names the exception. -->
      <!-- The claim this comment used to make — "234x60 holds five with a line to spare at every
           tested DPI" — was arithmetic, not measurement, and it was wrong. At width 234 a Segoe UI 9
           line holds 41 characters, so that 200-character string wrapped to five lines needing 75
           units in a box of 60: the last line never rendered. Fixed by doing both — shorter copy AND
           an honest box — and DialogTextFitTests now measures it instead of anyone estimating. -->
      <Dialog Id="ObsyncPasswordRequiredDlg" Width="300" Height="120" Title="[ProductName] Setup">
        <Control Id="OK" Type="PushButton" X="122" Y="93" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" ToolTip="!(loc.InvalidDirDlgIconTooltip)" FixedSize="yes" IconSize="32" Text="!(loc.InvalidDirDlgIcon)" />
        <Control Id="Text" Type="Text" X="48" Y="15" Width="234" Height="60" NoPrefix="yes"
                 Text="Enter the password for this account, or the service installs but cannot start. Only a gMSA (DOMAIN\name$) or a built-in service account logs on without one." />
      </Dialog>
    </UI>

    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
